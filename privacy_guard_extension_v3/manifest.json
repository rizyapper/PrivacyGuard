{
  "manifest_version": 3,
  "name": "Privacy Guard",
  "version": "0.3.0",
  "description": "Privacy Guard with optional local Tor SOCKS proxy integration",
  "permissions": [
    "storage",
    "browsingData",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Privacy Guard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "gdpr.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fingerprint.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracking_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}